{
  "name": "nerdy-ads",
  "version": "1.0.0",
  "description": "Autonomous ad generation engine for Varsity Tutors SAT test prep campaigns",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "eval": "vitest run --project evals",
    "generate": "tsx src/main.ts",
    "researcher": "tsx src/scripts/run-researcher.ts",
    "calibrate": "tsx src/scripts/run-calibration.ts",
    "calibrate:ref": "tsx src/scripts/run-reference-calibration.ts",
    "pipeline": "tsx src/scripts/run-pipeline.ts",
    "view-run": "tsx src/scripts/view-run.ts",
    "stress-test": "tsx src/scripts/stress-test.ts",
    "ui": "cd ui && npm run dev",
    "ui:server": "tsx src/server/index.ts",
    "ui:dev": "npx concurrently \"npm run ui:server\" \"npm run ui\"",
    "build:prod": "cd ui && npm install && npx vite build",
    "start:prod": "NODE_ENV=production tsx src/server/index.ts"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "langfuse": "^3.0.0",
    "tsx": "^4.0.0",
    "zod": "^3.24.0"
  }
}
